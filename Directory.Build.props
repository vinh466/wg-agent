<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning that reaches a review is a warning nobody reads. The SDK passes it
         through to the NativeAOT compiler too, so a trim or AOT warning fails the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- REQ-CFG-044 ships one self-contained NativeAOT binary with no runtime to
         install. NativeAOT also removes the JIT, which is what lets the systemd
         unit of SPEC-09 keep MemoryDenyWriteExecute=yes. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The agent targets Linux only (CLAUDE.md, glibc linux-x64). Declaring it at
       the assembly level lets CA1416 accept the Unix-only surface the store lock
       and file modes need, without a guard at every call site. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

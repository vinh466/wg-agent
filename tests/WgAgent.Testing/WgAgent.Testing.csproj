<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WgAgent.Testing</RootNamespace>

    <!-- Test infrastructure, not a production path: the AOT analysers that the
         adapters need do not apply here. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!-- The in-memory platform. It implements the ports of WgAgent.Platform so
       every layer above the adapters is exercised without privilege — the seam
       docs/00-overview/architecture.md fixes for the unit tier. -->
  <ItemGroup>
    <ProjectReference Include="../../src/WgAgent.Platform/WgAgent.Platform.csproj" />
  </ItemGroup>
</Project>

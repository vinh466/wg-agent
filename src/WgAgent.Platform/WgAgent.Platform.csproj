<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WgAgent.Platform</RootNamespace>
  </PropertyGroup>

  <!-- This project declares the ports and the types that cross them. It must
       not reference an adapter: the dependency points inwards, so a caller
       above this layer is testable without privilege. The only package here is
       the X25519 curve, because .NET 9 has none and Key owns the derivation. -->
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>
</Project>
